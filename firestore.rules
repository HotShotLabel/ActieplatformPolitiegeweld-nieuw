rules_version = '2';

// Actieplatform Politiegeweld
// Sinds de server-side schrijfroute (api/melden met de Admin SDK) schrijft
// de client niets meer rechtstreeks naar de database:
// - meldingen: volledig afgesloten (lezen en schrijven alleen via de server).
// - kaartpunten: publiek leesbaar voor de kaart, schrijven alleen via de
//   server.

service cloud.firestore {
  match /databases/{database}/documents {

    match /meldingen/{document} {
      allow read, write: if false;
    }

    match /kaartpunten/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Automatisch verzamelde nieuwsberichten (alleen via de server).
    match /nieuws/{document} {
      allow read, write: if false;
    }
  }
}
